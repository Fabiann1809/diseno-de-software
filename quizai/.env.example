# ─── Base de datos ────────────────────────────────────────────────────────────
# URI de conexión a MongoDB Atlas (reemplaza <user>, <password> y <cluster>)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=quizai_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens JWT (mínimo 32 caracteres, usa un valor aleatorio)
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres
# Tiempo de expiración en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000

# ─── Groq API ─────────────────────────────────────────────────────────────────
# Obtén tu API key gratuita en: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo a usar (llama-3.3-70b-versatile está disponible en el plan gratuito)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=8080
